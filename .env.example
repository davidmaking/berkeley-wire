# Copy this file to .env and fill in the values you want to use.
# .env is gitignored, so real keys never get committed.

# Optional: enables the AI news filter + blurb tidy passes.
# Free tier key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: enables pulling posts from r/berkeley.
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
